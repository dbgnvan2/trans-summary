{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trans-summary/schemas/topics.schema.json",
  "title": "Topics",
  "version": "1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "artifact", "items"],
  "properties": {
    "version": {"const": "1"},
    "artifact": {"const": "topics"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "percentage", "sections", "description"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "percentage": {"type": "integer", "minimum": 0, "maximum": 100},
          "sections": {"type": "string"},
          "description": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
