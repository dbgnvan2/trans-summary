{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trans-summary/schemas/bowen.schema.json",
  "title": "Bowen references",
  "version": "1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "artifact", "items"],
  "properties": {
    "version": {"const": "1"},
    "artifact": {"const": "bowen"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["concept", "quote"],
        "properties": {
          "concept": {"type": "string", "minLength": 1},
          "quote": {"type": "string", "minLength": 1},
          "timestamp": {
            "type": ["string", "null"],
            "pattern": "^\\d{2}:\\d{2}:\\d{2}$"
          }
        }
      }
    }
  }
}
