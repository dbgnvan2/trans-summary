{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trans-summary/schemas/emphasis.schema.json",
  "title": "Scored emphasis items",
  "version": "1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "artifact", "items"],
  "properties": {
    "version": {"const": "1"},
    "artifact": {"const": "emphasis"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "category", "score", "concept", "quote"],
        "properties": {
          "type": {"type": "string", "enum": ["Explicit", "Implicit", "Clinical"]},
          "category": {"type": "string", "minLength": 1},
          "score": {"type": "integer", "minimum": 0, "maximum": 100},
          "concept": {"type": "string", "minLength": 1},
          "quote": {"type": "string", "minLength": 1},
          "timestamp": {
            "type": ["string", "null"],
            "pattern": "^\\d{2}:\\d{2}:\\d{2}$"
          }
        }
      }
    }
  }
}
