{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trans-summary/schemas/themes.schema.json",
  "title": "Themes (structural or interpretive)",
  "description": "Version 2 is the structured object the theme stages return and save (ST, docs/plan_structured_themes_2026-10-14.md). Version 1 is the shape derived from a markdown file (number, name, description), still used for older files and for the markdown parsers' output.",
  "version": "2",
  "oneOf": [
    {"$ref": "#/$defs/v1"},
    {"$ref": "#/$defs/v2_structural"},
    {"$ref": "#/$defs/v2_interpretive"}
  ],
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "title": {"type": "string", "minLength": 1, "pattern": "^[^*\\n]*\\S[^*\\n]*$"},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
    "v1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "artifact", "kind", "items"],
      "properties": {
        "version": {"const": "1"},
        "artifact": {"const": "themes"},
        "kind": {"type": "string", "enum": ["structural", "interpretive"]},
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["number", "name", "description"],
            "properties": {
              "number": {"type": "integer", "minimum": 1},
              "name": {"type": "string", "minLength": 1},
              "description": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "structural_theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "title", "description", "key_evidence", "coverage_role"],
      "properties": {
        "number": {"type": "integer", "minimum": 1},
        "title": {"$ref": "#/$defs/title"},
        "description": {"$ref": "#/$defs/text"},
        "key_evidence": {"$ref": "#/$defs/evidence"},
        "coverage_role": {"$ref": "#/$defs/text"}
      }
    },
    "interpretive_theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "title", "description", "nested_under", "key_evidence", "lens_fuel_value"],
      "properties": {
        "number": {"type": "integer", "minimum": 1},
        "title": {"$ref": "#/$defs/title"},
        "description": {"$ref": "#/$defs/text"},
        "nested_under": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
        "key_evidence": {"$ref": "#/$defs/evidence"},
        "lens_fuel_value": {"$ref": "#/$defs/text"}
      }
    },
    "v2_structural": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "artifact", "kind", "items"],
      "properties": {
        "version": {"const": "2"},
        "artifact": {"const": "themes"},
        "kind": {"const": "structural"},
        "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/structural_theme"}},
        "rationale": {"type": "string"}
      }
    },
    "v2_interpretive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "artifact", "kind", "items"],
      "properties": {
        "version": {"const": "2"},
        "artifact": {"const": "themes"},
        "kind": {"const": "interpretive"},
        "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/interpretive_theme"}},
        "rationale": {"type": "string"}
      }
    }
  }
}
