{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trans-summary/schemas/themes.schema.json",
  "title": "Themes (structural or interpretive)",
  "version": "1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "artifact", "kind", "items"],
  "properties": {
    "version": {"const": "1"},
    "artifact": {"const": "themes"},
    "kind": {"type": "string", "enum": ["structural", "interpretive"]},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["number", "name", "description"],
        "properties": {
          "number": {"type": "integer", "minimum": 1},
          "name": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
